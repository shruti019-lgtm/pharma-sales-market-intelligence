  <worksheets>
    <worksheet name='Day vs Night Sales Distribution'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Sales volume is noticeably higher during </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Day (OPD) hours</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>, highlighting the importance of doctor visit windows and field force activity timing for maximizing pharmaceutical sales.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Day_vs_Night (pharma_business_tables)' name='federated.1ogh00g0ix48f913p3n5w0hirm32' />
          </datasources>
          <datasource-dependencies datasource='federated.1ogh00g0ix48f913p3n5w0hirm32'>
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='Therapy Name' datatype='string' name='[Therapy_Name]' role='dimension' type='nominal' />
            <column caption='Time Block' datatype='string' name='[Time_Block]' role='dimension' type='nominal' />
            <column-instance column='[Therapy_Name]' derivation='None' name='[none:Therapy_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Time_Block]' derivation='None' name='[none:Time_Block:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.1ogh00g0ix48f913p3n5w0hirm32].[none:Time_Block:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Day&quot;</bucket>
              <bucket>&quot;Night&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.1ogh00g0ix48f913p3n5w0hirm32].[none:Time_Block:nk]</column>
            <column>[federated.1ogh00g0ix48f913p3n5w0hirm32].[none:Therapy_Name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
