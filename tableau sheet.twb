    <dashboard name='Pharma Sales &amp; Market Intelligence Story' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Overall Pharma Sales Performance Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='939' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3216' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4046' />
            <zone h='84647' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='14523'>
              <flipboard active-id='3' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='This view provides a high-level summary of therapy-wise market share and sales distribution across different time blocks.' captured-sheet='Dashboard 1' id='1' />
                  <story-point caption='                                                                                                          Therapy-wise Market Share Analysis' captured-sheet='Therapy-wise Market Share (%)' id='2' />
                  <story-point caption='                                                                                                            Impact of Doctor Visit Timing on Sales' captured-sheet='Day vs Night Sales Distribution' id='3' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' h='7884' hidden='true' id='6' story-point-id='2' type-v2='text' w='33268' x='60630' y='14730'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>A small number of therapies contribute the majority of total sales, indicating portfolio concentration and focus areas for brand investment.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='7884' id='7' story-point-id='3' type-v2='text' w='33268' x='62402' y='14834'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Sales are significantly higher during Day (OPD) hours compared to Night (Non-OPD), highlighting the importance of aligning field force activity with doctor availability.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{D4EAB402-F1BB-4561-933A-11116A94E672}' />
    </dashboard>
